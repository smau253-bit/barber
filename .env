# ==========================================
# CONFIGURACIÓN DEL BACKEND
# ==========================================

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# BASE DE DATOS MySQL
# ==========================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=barberia_db

# ==========================================
# AUTENTICACIÓN (JWT)
# ==========================================

JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==========================================
# SEGURIDAD
# ==========================================

SESSION_SECRET=
COOKIE_SECURE=false

# ==========================================
# CONFIGURACIÓN DEL FRONTEND
# ==========================================

VITE_API_URL=http://localhost:4000
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME="Barbería El Compa    "